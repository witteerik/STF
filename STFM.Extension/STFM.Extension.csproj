<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>

		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<!--<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseMonoRuntime>false</UseMonoRuntime>
	</PropertyGroup>-->

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.101" />
	</ItemGroup>

	<!-- USB otoscopy uses VisioForge's Android UVC source, not the built-in camera API. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="VisioForge.DotNet.VideoCapture" Version="2026.11.6" />
		<PackageReference Include="VisioForge.DotNet.Core.UI.MAUI" Version="2026.11.6" />
		<PackageReference Include="VisioForge.CrossPlatform.Core.Android" Version="2026.11.5" />
		<!-- Match the Lifecycle 2.10 family required by VisioForge's MAUI preview. -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.4.0.2" />
		<ProjectReference Include="..\ThirdParty\VisioForge.Android\VisioForge.Core.Android.X10.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Drawables\" />
		<Folder Include="ViewElements\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\STFM.Core\STFM.Core.csproj" />
		<ProjectReference Include="..\STFN.Extension\STFN.Extension.vbproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\TestResultView_MultiAdaptiveSiP.xaml.cs">
			<DependentUpon>TestResultView_MultiAdaptiveSiP.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\TestResultView_MultiAdaptiveSiP.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\TestResultView_MultiFixedSiP.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\TwgPanelView.xaml">
			<Generator></Generator>
		</MauiXaml>
		<MauiXaml Update="Views\TwgPanelView_ConstantStimuli.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!--<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>-->

</Project>
